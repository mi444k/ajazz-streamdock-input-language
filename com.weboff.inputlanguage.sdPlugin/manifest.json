{
  "Name": "Input Language by Weboff",
  "Version": "0.3.0",
  "Description": "Show and cycle keyboard input sources on Windows and macOS.",
  "Author": "Weboff",
  "SDKVersion": 1,
  "Icon": "images/icon.png",
  "Category": "Input Language",
  "CategoryIcon": "images/category.png",
  "CodePath": "src/plugin.js",
  "CodePathMac": "src/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13.0"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "2.10.179.426"
  },
  "Actions": [
    {
      "UUID": "com.weboff.inputlanguage.cycle",
      "Name": "Input Language",
      "Tooltip": "Show the current keyboard language. Press to cycle available input sources.",
      "Icon": "images/action.png",
      "Controllers": [
        "Keypad",
        "Knob"
      ],
      "States": [
        {
          "Image": "images/idle.png",
          "ShowTitle": true,
          "FontSize": "22",
          "FontStyle": "Bold",
          "TitleAlignment": "middle",
          "TitleColor": "#F5FBFF"
        }
      ],
      "DisableAutomaticStates": true,
      "UserTitleEnabled": true,
      "SupportedInMultiActions": false
    }
  ],
  "CodePathWin": "src/plugin.js"
}
